import os
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes

TOKEN ="8809457984:AAGcZ0peBoJxb7qAu6XmJKtqU4FgcPkImWc"
ADMIN_ID =52504489

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    welcome_text = f"أهلاً بك يا {user.first_name} في البوت!"
    await update.message.reply_text(welcome_text)
    
    admin_notice = f"🔔 دخول جديد للبوت!\nالاسم: {user.first_name}\nاليوزر: @{user.username}\nالأيدي: {user.id}"
    try:
        await context.bot.send_message(chat_id=ADMIN_ID, text=admin_notice)
    except Exception as e:
        print(e)

def main():
    app = ApplicationBuilder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    print("Bot is running...")
    app.run_polling()

if __name__ == '__main__':
    main()
